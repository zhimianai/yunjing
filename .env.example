# 复制此文件为 .env，然后填入你自己的 API Key（.env 已被 .gitignore 忽略）

# === API Keys ===
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
WENXIN_API_KEY=bce-v3/xxxxxxxxxxxxxxxxxxxxxxxx

# === 当前使用的提供商和模型 ===
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat

# === 功能开关 ===
ENABLE_SEARCH=false

# === 可选: 自定义 Base URL ===
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# === 短信验证码配置 ===
# SMS_PROVIDER=none          # none=开发模式(不真发短信), aliyun=阿里云, tencent=腾讯云
# SMS_ACCESS_KEY=            # 短信服务 AccessKey ID / SecretId
# SMS_SECRET=                # 短信服务 AccessKey Secret / SecretKey
# SMS_SIGN=云镜AI            # 短信签名
# SMS_TEMPLATE=              # 短信模板 Code, 阿里云 SMS_xxxxx, 腾讯云 123456